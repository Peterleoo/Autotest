# ==============================================================================
# 1. 核心敏感信息与大模型授权凭证 (严禁提交上传)
# ==============================================================================
# Google Antigravity / Gemini OAuth 授权凭据及 Token 缓存
config/antigravity_oauth.json
*oauth*.json
*gemini*.json
*google*.json
*token*.json
**/desktop-home/*

# 企业许可与激活凭据
data/auth_license.json

# 本地环境变量配置 (请使用 .env.example 作为公开模板)
.env
.env.local
.env.*.local

# 运行态会话历史 (包含用户真实 Prompt 与大模型交互记录)
data/sessions/*
!data/sessions/.gitkeep

# ==============================================================================
# 2. Python 运行时与虚拟环境缓存
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.cache/

# ==============================================================================
# 3. 测试报告、截图与中间产物
# ==============================================================================
.pytest_cache/
reports/*.html
reports/*.json
reports/allure_results/*
reports/screenshots/*
!reports/screenshots/.gitkeep

# 临时调试图片与截图
*.png
*.jpg
*.jpeg
pgyer_dom.html

# ==============================================================================
# 4. 二进制包与临时草稿
# ==============================================================================
apps/*.apk
apps/*.ipa
*.apk
*.ipa

# 临时开发调试草稿与项目管理本地缓存
scratch/
.pm/
*.tmp
*.log

# ==============================================================================
# 5. 操作系统与 IDE 配置
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
