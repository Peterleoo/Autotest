# ===== 移动测试目标平台与设备 =====
TARGET_PLATFORM=android
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Android 配置
ANDROID_DEVICE_NAME=Android_Device
ANDROID_APP_NAME=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# iOS 配置（指向局域网 Mac 机器上的 Appium 服务）
IOS_DEVICE_NAME=iPhone 15
APPIUM_SERVER_URL_IOS=http://192.168.1.100:4723
IOS_UDID=
IOS_BUNDLE_ID=

# 接口测试 Base URL
API_BASE_URL=https://httpbin.org

# ===== AI 模型接入配置 (支持: deepseek / claude / antigravity / openai) =====
AI_PROVIDER=claude

# 1. DeepSeek 配置 (https://api.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2. Claude / Anthropic 配置
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. Antigravity / Gemini 授权配置
ANTIGRAVITY_API_KEY=your_gemini_key_here
ANTIGRAVITY_MODEL=gemini-2.5-flash

# 4. 通用 OpenAI / 本地模型配置
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
