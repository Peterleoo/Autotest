# ===== 移动测试目标平台与设备 =====
TARGET_PLATFORM=android
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Android 配置
ANDROID_DEVICE_NAME=Android_Device
ANDROID_APP_NAME=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# iOS 配置（指向局域网 Mac 机器上的 Appium 服务）
IOS_DEVICE_NAME=iPhone 15
APPIUM_SERVER_URL_IOS=http://192.168.1.100:4723
IOS_UDID=
IOS_BUNDLE_ID=

# 接口测试 Base URL
API_BASE_URL=https://httpbin.org

# ===== AI 模型接入配置 (支持: deepseek / claude / antigravity / openai) =====
AI_PROVIDER=claude

# 1. DeepSeek 配置 (https://api.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2. Claude / Anthropic 配置
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. Antigravity / Gemini 授权配置
ANTIGRAVITY_API_KEY=your_gemini_key_here
ANTIGRAVITY_MODEL=gemini-2.5-flash
# 可选：只读的外部 OAuth 桥接文件，本地 config/antigravity_oauth.json 不存在时回退读取
# ANTIGRAVITY_OAUTH_BRIDGE_FILE=D:/path/to/gemini-oauth-bridge.json
# Antigravity OAuth 客户端凭据（必填，仅放本地 .env，切勿提交到仓库）
ANTIGRAVITY_CLIENT_ID=your_oauth_client_id
ANTIGRAVITY_CLIENT_SECRET=your_oauth_client_secret
# 本地桥接服务 tools/antigravity_bridge.py：默认只监听本机，勿改为 0.0.0.0
# ANTIGRAVITY_BRIDGE_HOST=127.0.0.1
# ANTIGRAVITY_BRIDGE_PORT=19387
# 可选访问密钥：设置后需与 ANTIGRAVITY_API_KEY 保持一致（客户端以它作为 Bearer 发送）
# ANTIGRAVITY_BRIDGE_KEY=

# 数据保留策略（服务启动时执行；天数为 0 表示不清理，每个目录始终保留最新 N 个文件）
# REPORTS_RETENTION_DAYS=30
# SESSIONS_RETENTION_DAYS=90
# RETENTION_KEEP_LATEST=50

# 投屏与真机取帧（scrcpy 硬件 H.264 推流，真机端负载远低于反复全分辨率截屏）
# 前置：pip install av；python tools/fetch_scrcpy_server.py 下载并校验 scrcpy-server
# SCREEN_STREAM_BACKEND=auto        # auto(可用则推流) | scrcpy | screencap(始终截屏)
# SCRCPY_MAX_SIZE=960               # 推流长边像素
# SCRCPY_LIVE_FPS=10                # 有测试运行时帧率
# SCRCPY_IDLE_FPS=2                 # 空闲时帧率
# SCRCPY_BIT_RATE=2000000
# AUTOTEST_SCREEN_SERVER=http://127.0.0.1:8000   # AI 子进程取推流帧的服务地址，off 关闭
# DEVICE_GZIP_CAPTURE=1             # 回退截屏时端侧 gzip 压缩；老机型设 0 省 CPU

# 4. 通用 OpenAI / 本地模型配置
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
